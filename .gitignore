# kore — 忽略规则（按用途分组，只忽略生成物与本地状态，不忽略源码/文档）

# ---- Go 构建产物 ----
/kore
/kored
/bin/
*.test
*.out
coverage.*

# ---- 前端（Vue3 + Vite + TS）----
web/node_modules/
web/dist/
*.local

# ---- 本地状态与运行目录 ----
.tmp/
tmp/
/var/
kore.db
*.sock
*.log

# ---- 多仓库联调（go work，ADR-0008）----
# 多仓库联调文件，禁止提交：go.work / go.work.sum 不得入库
go.work
go.work.sum

# ---- 编辑器与 IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- 操作系统垃圾文件 ----
.DS_Store
Thumbs.db

# ---- 密钥与环境（.env.example 必须保留，作为配置契约）----
.env
.env.*
!.env.example
*.pem
*.key

# ---- 签名私钥（ADR-0025：长期密钥托管在仓库外，仅兜底防误提交）----
*.seed
.index-signing*
index-signing*
keys/index-signing*

# ---- agent 临时产物 ----
.agents/tmp/

# ---- 运行态资产（G-29：禁止入库，用 git check-ignore 验证）----
# 全系列兜底：yaml / state / run / log / index 一次覆盖，防止 git add . 把 123 MiB state.db 带进提交
.kore-local*
# 显式列出覆盖范围，便于 review 辨认（与上一行等价，不依赖通配符推断）
.kore-local-state/
.kore-local-run/
.kore-local-log/
.kore-local-index/
# 配置示例是契约不是运行态，必须保留入库（与 .env.example 同理）
!.kore-local.yaml.example

# ---- 验收证据（G-28）：报告 *.md 与 screenshots/*.png 入库，原始采样与临时物不入库 ----
.agents/verify/**/*-raw.json
.agents/verify/tmp/
.agents/verify/**/chrome-profile/
.agents/verify/**/profile/
